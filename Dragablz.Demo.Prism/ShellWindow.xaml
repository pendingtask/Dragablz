<Window
    x:Class="Dragablz.Demo.Prism.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Dragablz + Prism MVVM Demo"
    Width="1100"
    Height="620"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ═══ Left Control Panel ═══  -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Dragablz MVVM Demo" />

                <!--  Mode Selection  -->
                <GroupBox
                    Margin="0,0,0,8"
                    Padding="6"
                    Header="Mode Selection">
                    <StackPanel>
                        <RadioButton
                            Margin="0,2"
                            Content="MVVM (Commands only)"
                            IsChecked="{Binding IsMvvmMode}" />
                        <RadioButton
                            Margin="0,2"
                            Content="Callback/Factory only"
                            IsChecked="{Binding IsCallbackMode}" />
                        <RadioButton
                            Margin="0,2"
                            Content="Mixed (Commands + Callback)"
                            IsChecked="{Binding IsMixedMode}" />
                    </StackPanel>
                </GroupBox>

                <!--  Options  -->
                <GroupBox
                    Margin="0,0,0,8"
                    Padding="6"
                    Header="Options">
                    <StackPanel>
                        <CheckBox
                            Margin="0,2"
                            Content="ShowDefaultCloseButton"
                            IsChecked="{Binding ShowCloseButton}" />
                        <CheckBox
                            Margin="0,2"
                            Content="ShowDefaultAddButton"
                            IsChecked="{Binding ShowAddButton}" />
                        <StackPanel Margin="0,4" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="FixedHeaderCount:" />
                            <TextBox
                                Width="40"
                                Text="{Binding FixedHeaderCount, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,4" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="AddLocationHint:" />
                            <ComboBox
                                Width="100"
                                ItemsSource="{Binding AddLocationHintValues}"
                                SelectedItem="{Binding SelectedAddLocationHint}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!--  Add Tab Buttons  -->
                <GroupBox
                    Margin="0,0,0,8"
                    Padding="6"
                    Header="Add Tabs">
                    <StackPanel>
                        <Button
                            Margin="0,2"
                            Padding="6,4"
                            Command="{Binding AddTabCommand}"
                            Content="Add via Command (MVVM)" />
                        <TextBlock
                            Margin="4,0,0,4"
                            FontSize="10"
                            Foreground="Gray"
                            Text="(uses AddingItemCommand binding)" />
                        <Button
                            Margin="0,2"
                            Padding="6,4"
                            Command="{Binding AddPredefinedTabsCommand}"
                            Content="Seed Predefined Tabs" />
                    </StackPanel>
                </GroupBox>

                <!--  Log  -->
                <GroupBox
                    Margin="0,0,0,8"
                    Padding="6"
                    Header="Action Log">
                    <StackPanel>
                        <Button
                            Margin="0,2"
                            Padding="6,4"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearLogCommand}"
                            Content="Clear Log" />
                        <ScrollViewer MaxHeight="200" Margin="0,4,0,0">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="{Binding LastActionLog}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </GroupBox>

                <!--  Legend  -->
                <GroupBox
                    Margin="0,0,0,8"
                    Padding="6"
                    Header="Legend">
                    <StackPanel>
                        <TextBlock Margin="0,2" FontSize="10">
                            <Run FontWeight="Bold" Text="MVVM:" />
                            <Run Text=" Close/Add via ICommand binding" />
                        </TextBlock>
                        <TextBlock Margin="0,2" FontSize="10">
                            <Run FontWeight="Bold" Text="Callback:" />
                            <Run Text=" Close shows dialog, Add uses factory" />
                        </TextBlock>
                        <TextBlock Margin="0,2" FontSize="10">
                            <Run FontWeight="Bold" Text="Mixed:" />
                            <Run Text=" Command fires first, then Callback/Factory" />
                        </TextBlock>
                        <Separator Margin="0,4" />
                        <TextBlock Margin="0,2" FontSize="10">
                            <Run FontWeight="Bold" Text="Fixed tabs:" />
                            <Run Text=" First N tabs cannot be closed or dragged" />
                        </TextBlock>
                        <TextBlock Margin="0,2" FontSize="10">
                            <Run FontWeight="Bold" Text="Drag tab out:" />
                            <Run Text=" Creates new window (InterTabController)" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!--  ═══ Separator ═══  -->
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch"
            Background="LightGray" />

        <!--  ═══ Main TabablzControl ═══  -->
        <dragablz:TabablzControl
            Grid.Column="2"
            Margin="4,0,0,0"
            AddLocationHint="{Binding SelectedAddLocationHint}"
            AddingItemCommand="{Binding EffectiveAddingItemCommand}"
            ClosingItemCallback="{Binding EffectiveClosingItemCallback}"
            ClosingItemCommand="{Binding EffectiveClosingItemCommand}"
            FixedHeaderCount="{Binding FixedHeaderCount}"
            ItemContainerStyle="{StaticResource TrapezoidDragableTabItemStyle}"
            ItemsSource="{Binding Tabs}"
            NewItemFactory="{Binding EffectiveNewItemFactory}"
            ShowDefaultAddButton="{Binding ShowAddButton}"
            ShowDefaultCloseButton="{Binding ShowCloseButton}">
            <dragablz:TabablzControl.HeaderItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </dragablz:TabablzControl.HeaderItemTemplate>
            <dragablz:TabablzControl.ContentTemplate>
                <DataTemplate>
                    <Border Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Margin="0,0,0,8"
                                Padding="0,0,0,8"
                                BorderBrush="LightGray"
                                BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="Header: " />
                                    <TextBox Width="300" Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="  IsSelected: " />
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1">
                                <TextBlock
                                    FontSize="13"
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </dragablz:TabablzControl.ContentTemplate>
        </dragablz:TabablzControl>
    </Grid>
</Window>
