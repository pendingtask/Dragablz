<Application
    x:Class="Dragablz.Demo.Prism.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dragablz;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Dragablz;component/Themes/MaterialDesign.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#3F51B5" />
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#7986CB" />
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#303F9F" />
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#FF4081" />
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FAFAFA" />
            <SolidColorBrush x:Key="MaterialDesignBody" Color="#DD000000" />
            <SolidColorBrush x:Key="MaterialDesignColumnHeader" Color="#99000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
